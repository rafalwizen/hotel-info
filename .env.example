# Postgres connection string (Neon: https://console.neon.tech)
# Local dev should point at a Neon branch, not a local Postgres, for prod parity.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js session secret (generate: npx auth secret)
AUTH_SECRET=""

# Public base URL used in QR codes, e.g. https://go.example.com
# Must NOT have a trailing slash.
GUEST_BASE_URL="http://localhost:3000"

# Optional: Resend API key for transactional email (password reset)
RESEND_API_KEY=""
EMAIL_FROM="Hotel Info <no-reply@example.com>"

# Optional: Vercel Blob token for arrival-guide photo uploads
# (Vercel console -> Storage -> Blob -> connect to the project)
BLOB_READ_WRITE_TOKEN=""

# Optional: AI assistant (widget hidden while ASSISTANT_API_KEY is empty).
# Defaults target the z.ai Anthropic-compatible endpoint — a GLM Coding Plan
# key works as ASSISTANT_API_KEY with ASSISTANT_AUTH_MODE="authToken".
# For the standard Anthropic API set BASE_URL to https://api.anthropic.com
# and AUTH_MODE to "apiKey". Static pages bake the enabled flag at build
# time, so changing the key on Vercel requires a redeploy.
ASSISTANT_BASE_URL="https://api.z.ai/api/anthropic"
ASSISTANT_API_KEY=""
ASSISTANT_MODEL="glm-5.3-flash"
ASSISTANT_AUTH_MODE="authToken"
